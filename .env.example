NUXT_APP_NAME="NGI Firn"
NUXT_APP_URL=http://localhost:3000

NUXT_MAIL_KEY=
NUXT_MAIL_FROM=hello@example.com
# The e-mail associated with the first account on the site, will have admin privileges automatically.
FIRST_ADMIN_EMAIL=firn.user@scilifelab.se

NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=

NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# at least 32 characters
NUXT_SESSION_PASSWORD=
# a short string used as salt when a key is derived from the session password
NUXT_SESSION_SALT=
# development or production, in production cross origin will be disabled
NODE_ENV=development

# define local HTTPS certificates to use in development mode (optional)
LOCALHOST_HTTPS_KEY=
LOCALHOST_HTTPS_CERT=

# Database connection with CouchDB. 
# DO NOT CHANGE THE NAME OF THE ENV VARIABLES TO SAY 'COUCH_URL', THEY ARE HARDCODED IN THE IBM CODE 
# AND WILL PRODUCE ODD RANDOM ERRORS OTHERWISE.
CLOUDANT_AUTH_TYPE=COUCHDB_SESSION
CLOUDANT_URL=
CLOUDANT_USERNAME=
CLOUDANT_PASSWORD=
# The database name of the main database to use for the application.
CLOUDANT_DATABASE=
# The database name of the projects database (read-only, same as GenStat)
CLOUDANT_PROJECTS_DATABASE=
# CLOUDANT_COMPRESSION=true or CLOUDANT_COMPRESSION=1 will enable it for modern CouchDB versions.
CLOUDANT_COMPRESSION=

# ---------------------------------------------------------------------------
# Global search (Meilisearch) — OPTIONAL
# ---------------------------------------------------------------------------
# The global inventory/project search is backed by a self-hosted Meilisearch
# instance. The feature degrades gracefully: when MEILISEARCH_HOST is unset the
# search page reports "unavailable" and the rest of the app is unaffected.
#
# In the production container Meilisearch runs as a private, loopback-only
# sidecar (127.0.0.1:7700, never published) supervised alongside Nuxt, so the
# default host below is correct there. For local macOS development run the
# binary separately (`meilisearch --db-path ./.meili_data`) and point here.
MEILISEARCH_HOST=http://127.0.0.1:7700
# Master key / API key. REQUIRED when Meilisearch runs with `--env production`.
# Keep this server-only; it is never exposed to the browser. Generate a strong
# random value (e.g. `openssl rand -base64 32`).
MEILISEARCH_API_KEY=
# Optional: namespace the index names (defaults to "firn"). Index names are
# additionally scoped by CLOUDANT_DATABASE so environments never collide.
MEILISEARCH_INDEX_PREFIX=
# Optional indexer tuning (milliseconds). Defaults: sync 30000, rebuild 600000.
MEILISEARCH_SYNC_INTERVAL_MS=
MEILISEARCH_REBUILD_INTERVAL_MS=
