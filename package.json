{
  "name": "ngi-firn",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "description": "A laboratory freezer inventory management system created with Nuxt3, Vue and UnaUI.",
  "author": "Matthias Zepper <MatthiasZepper@users.noreply.github.com>",
  "license": "MIT",
  "homepage": "https://ngisweden.scilifelab.se",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NationalGenomicsInfrastructure/ngi-firn.git"
  },
  "bugs": "https://github.com/NationalGenomicsInfrastructure/ngi-firn/issues",
  "keywords": [
    "ngi",
    "scilifelab",
    "laboratory-management",
    "inventory-system",
    "freezer-management",
    "sample-tracking",
    "scientific-application",
    "laboratory-information-system",
    "genomics",
    "bioinformatics",
    "nuxt",
    "vue",
    "database",
    "web-application"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "nuxi dev",
    "dev:https": "export NODE_EXTRA_CA_CERTS=\"$(mkcert -CAROOT)/rootCA.pem\" && nuxi dev",
    "dev:build-node": "node --env-file=.env .output/server/index.mjs",
    "dev:with-search": "MEILI_DB_PATH=./.meili_data node --env-file-if-exists=.env scripts/dev-with-search.mjs",
    "build": "nuxi build",
    "build-analyze": "NITRO_ANALYZE=1 NITRO_DEBUG=1 nuxi build",
    "start": "node .output/server/index.mjs",
    "typecheck": "npx nuxi typecheck",
    "lint": "eslint .",
    "postinstall": "nuxt prepare",
    "db:init": "tsx scripts/init-db.ts",
    "db:test": "tsx scripts/test-db-connection.ts",
    "test": "vitest run",
    "test:integration": "vitest run",
    "test:watch": "vitest",
    "test:typecheck": "vue-tsc --noEmit -p tsconfig.vitest.json",
    "test:barcode": "vitest run tests/integration/barcode-scan.test.ts",
    "test:bombadil": "bash tests/bombadil/run.sh",
    "test:bombadil:typecheck": "tsc --noEmit -p tsconfig.bombadil.json",
    "test:labels": "tsx scripts/test-label-sheet.ts",
    "db:views": "tsx scripts/ensure-views.ts",
    "db:views:projects": "tsx scripts/pull-project-views.ts"
  },
  "dependencies": {
    "@ibm-cloud/cloudant": "^0.12.27",
    "@nuxthub/core": "^0.10.12",
    "@pinia/colada": "^1.4.9",
    "@pinia/colada-nuxt": "^1.2.1",
    "@pinia/nuxt": "^1.0.3",
    "@tanstack/vue-table": "^8.21.3",
    "@trpc/client": "^11.24.0",
    "@trpc/server": "^11.24.0",
    "@una-ui/nuxt": "0.67.10",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^15.0.0",
    "h3-zod": "^0.5.3",
    "jose": "^6.2.15",
    "jsbarcode": "^3.12.3",
    "luxon": "^3.7.2",
    "meilisearch": "^0.62.0",
    "nuxt": "^4.6.4",
    "nuxt-auth-utils": "^0.5.34",
    "pdfmake": "^0.3.13",
    "pinia": "^4.1.0",
    "qrcode": "^1.5.4",
    "qrcode.vue": "^3.11.0",
    "trpc-nuxt": "^2.2.0",
    "zod": ">=4.6.6",
    "zxing-wasm": "^3.1.6"
  },
  "devDependencies": {
    "@antithesishq/bombadil": "0.7.10",
    "@iconify-json/lucide": "^1.2.151",
    "@iconify-json/radix-icons": "^1.2.6",
    "@iconify-json/simple-icons": "^1.2.101",
    "@iconify-json/tabler": "^1.2.43",
    "@nuxt/devtools": "^3.4.4",
    "@nuxt/eslint": "^1.17.0",
    "@types/luxon": "^3.7.6",
    "@types/pdfmake": "^0.3.3",
    "@types/qrcode": "^1.5.6",
    "@unocss/nuxt": "66.12.0",
    "@unocss/preset-wind4": "66.12.0",
    "dotenv": "^18.0.9",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "form-data": "4.0.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "unocss": "66.12.0",
    "vitest": "^5.1.0",
    "vue-tsc": "~3.2.9",
    "wrangler": "^4.157.0"
  },
  "packageManager": "pnpm@12.16.1"
}
